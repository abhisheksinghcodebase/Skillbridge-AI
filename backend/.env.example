# SkillBridge AI — Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+asyncpg://skillbridge:skillbridge123@localhost:5432/skillbridge_db

# Groq API (get free key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub (optional — for GitHub Analyzer)
GITHUB_TOKEN=your-github-personal-access-token

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
FRONTEND_URL=http://localhost:3000
